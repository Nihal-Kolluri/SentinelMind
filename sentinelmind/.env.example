# Hindsight (Cloud: https://ui.hindsight.vectorize.io -> copy your API URL + key; or local: http://localhost:8888)
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
# Groq (OpenAI-compatible)
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
# Seconds to wait after retain so Hindsight can finish fact extraction before the next recall
RETAIN_SETTLE_S=4
